{
  "name": "calculo-horas",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "vendor:supabase": "node scripts/vendor-supabase.mjs",
    "serve": "node scripts/serve-static.mjs",
    "build:config": "node scripts/generate-runtime-config.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "lint": "eslint . && prettier --check assets/css/style.css",
    "typecheck": "tsc -p .",
    "check": "npm run lint && npm run typecheck && npm run test:all",
    "format:css": "prettier --write assets/css/style.css",
    "test:visual": "node scripts/visual.mjs",
    "test:visual:update": "node scripts/visual.mjs --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
